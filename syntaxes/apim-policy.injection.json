{
  "scopeName": "apim.policy.injection",
  "injectionSelector": "L:text.xml",
  "patterns": [
    { "include": "#apim-tag-names" },
    { "include": "#apim-inline-expression" },
    { "include": "#apim-block-expression" },
    { "include": "#apim-named-value" }
  ],
  "repository": {
    "apim-tag-names": {
      "match": "(?<=</?)(policies|inbound|outbound|backend|on-error|fragment|include-fragment|base|choose|when|otherwise|set-header|set-body|set-variable|set-status|set-method|set-backend-service|return-response|mock-response|rewrite-uri|redirect-content-urls|find-and-replace|rate-limit|rate-limit-by-key|quota|quota-by-key|llm-token-limit|llm-emit-token-metric|llm-content-safety|azure-openai-token-limit|azure-openai-emit-token-metric|azure-openai-semantic-cache-lookup|azure-openai-semantic-cache-store|semantic-cache-lookup|semantic-cache-store|cache-lookup|cache-store|cache-lookup-value|cache-store-value|cache-remove-value|authentication-basic|authentication-certificate|authentication-managed-identity|validate-jwt|validate-azure-ad-token|validate-client-certificate|validate-content|validate-parameters|validate-headers|validate-status-code|jsonp|xml-to-json|json-to-xml|xsl-transform|forward-request|send-request|send-one-way-request|retry|trace|log-to-eventhub|ip-filter|cors|get-authorization-context|wait|emit-metric|invoke-dapr-binding|publish-to-dapr-pubsub|invoke-managed-endpoint)(?=[\\s/>])",
      "name": "entity.name.tag.apim.policy"
    },
    "apim-named-value": {
      "match": "\\{\\{[a-zA-Z0-9_\\-.]+\\}\\}",
      "name": "variable.parameter.namedvalue.apim"
    },
    "apim-inline-expression": {
      "begin": "@\\(",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.cs.apim" } },
      "end": "\\)(?=\")",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.cs.apim" } },
      "name": "meta.embedded.inline.csharp.apim",
      "patterns": [ { "include": "#cs-expression-body" } ]
    },
    "apim-block-expression": {
      "begin": "@\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.cs.apim" } },
      "end": "\\}(?=\\s*(<|$))",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.cs.apim" } },
      "name": "meta.embedded.block.csharp.apim",
      "patterns": [ { "include": "#cs-expression-body" } ]
    },
    "cs-expression-body": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.cs.apim" },
        { "match": "/\\*", "name": "comment.block.cs.apim", "end": "\\*/" },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.cs.apim",
          "patterns": [ { "match": "\\\\.", "name": "constant.character.escape.cs.apim" } ]
        },
        {
          "match": "\\b(var|new|true|false|null|if|else|return|foreach|in|as|is|string|int|bool|object|void|using|from|select|where|orderby|let|yield|switch|case|default|try|catch|finally|throw|this|typeof|async|await)\\b",
          "name": "keyword.control.cs.apim"
        },
        {
          "match": "\\bcontext\\.(Request|Response|Variables|Api|Operation|User|Subscription|Deployment|Product|LastError|Tracing|Elapsed|RequestId|Timestamp)\\b",
          "name": "variable.language.context.cs.apim"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()",
          "name": "entity.name.function.cs.apim"
        },
        {
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
          "name": "constant.numeric.cs.apim"
        }
      ]
    }
  }
}
